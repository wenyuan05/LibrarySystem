# Server configuration
PORT=3001

# CORS configuration
# Same-origin reverse proxy deployment can use * because browsers will call /api on the same origin.
# Separate frontend/backend deployment should use exact frontend origins, comma-separated if needed.
FRONTEND_URL=*
# FRONTEND_URL=https://example.com,https://www.example.com

# JWT Configuration
JWT_SECRET=your-secret-key-here
