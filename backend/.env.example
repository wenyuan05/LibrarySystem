# Server configuration
PORT=3001

# CORS configuration
# Same-origin reverse proxy deployment can use * because browsers will call /api on the same origin.
# Separate frontend/backend deployment should use exact frontend origins, comma-separated if needed.
FRONTEND_URL=*
# FRONTEND_URL=https://example.com,https://www.example.com

# JWT Configuration
JWT_SECRET=your-secret-key-here

# Alipay sandbox payment configuration
# Keep these values in backend environment files only. Never expose private keys to the frontend.
ALIPAY_ENABLED=false
ALIPAY_MODE=sandbox
ALIPAY_APP_ID=your_sandbox_app_id
# You may paste either full PEM keys or the single-line base64 key body from Alipay sandbox.
ALIPAY_PRIVATE_KEY=your_app_private_key_body
ALIPAY_PUBLIC_KEY=your_alipay_public_key_body
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=http://localhost:3001/api/payments/alipay/notify
ALIPAY_RETURN_URL=http://localhost:5173/payment-result
ALIPAY_SIMULATION_ENABLED=true
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=utf-8
ALIPAY_FORMAT=json
ALIPAY_TIMEOUT_MS=10000

# ISBN lookup provider configuration
# Required only when using the ShowAPI ISBN provider.
SHOWAPI_ISBN_APP_KEY=your_showapi_app_key

# Backend outbound proxy for external ISBN APIs.
# auto: use the proxy only when host:port is reachable; off: never use proxy; on: always use proxy.
BACKEND_PROXY_MODE=auto
BACKEND_PROXY_HOST=127.0.0.1
BACKEND_PROXY_PORT=7890
